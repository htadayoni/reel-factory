# HTTP port of the API
PORT=3077
# Base URL used in the video/thumbnail links returned to n8n (must be reachable by whoever downloads the video)
PUBLIC_BASE_URL=http://localhost:3077
# Required header X-API-Key on every API call except /health and /files (leave empty only for local testing)
API_KEY=

# Where jobs, outputs and the TTS cache are stored (temporary)
DATA_DIR=data
# Long-lived files: AI image library (library/images) and published videos (library/videos)
LIBRARY_DIR=library
# How many videos render at the same time (keep 1 on a 2 vCPU VPS)
RENDER_CONCURRENCY=1
# Delete finished jobs and their videos after N hours (0 = keep forever)
RETENTION_HOURS=72
# Keep the generated HyperFrames project of each job (for debugging in HyperFrames Studio)
KEEP_WORK=0
# Serve ./samples at /samples (handy for tests; turn off in production)
SERVE_SAMPLES=1

# Text-to-speech
TTS_PROVIDER=piper
PIPER_VOICE=en_US-lessac-medium
# PIPER_BIN=.venv-piper/bin/piper
# PIPER_MODELS_DIR=models/piper
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# AI images for the image library (generated only when a key is missing from the library)
# openrouter (default) | openai (direct, uses OPENAI_API_KEY)
IMAGE_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# low (~$0.01) | medium (~$0.04) | high (~$0.17) per 1024x1024 image
OPENAI_IMAGE_QUALITY=medium
IMAGE_CONCURRENCY=3

# OpenRouter: one key for AI images (default) and ElevenLabs voices (voice.provider "openrouter")
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1-mini
# low | medium | high (the cost of each generated image is recorded in library/images/index.json)
OPENROUTER_IMAGE_QUALITY=medium
OPENROUTER_TTS_MODEL=elevenlabs/eleven-multilingual-v2
# Premade voice name (george, rachel, ...) or an ElevenLabs voice-library ID
OPENROUTER_TTS_VOICE=george
