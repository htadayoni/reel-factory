{
  "name": "reel-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Template-driven Instagram reel renderer for n8n (HyperFrames + TTS)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "render": "node --env-file-if-exists=.env scripts/render.js",
    "setup:piper": "bash scripts/setup-piper.sh",
    "n8n:install": "npm --prefix local-n8n install",
    "n8n:setup": "bash local-n8n/setup.sh",
    "n8n:start": "bash local-n8n/start.sh"
  },
  "dependencies": {
    "@fontsource/lora": "^5.3.0",
    "express": "^4.22.3",
    "flag-icons": "^7.6.0",
    "gsap": "^3.15.0",
    "hyperframes": "0.8.172",
    "zod": "^4.6.7"
  }
}
